# ---------------------------------------------------------------------------
# Q-REX environment. Copy to .env and adjust.
# ---------------------------------------------------------------------------

# App secret (used to sign re-auth links). Change it.
SECRET=change-me-dev-secret

# Fernet key for session encryption at rest.
# DEV ONLY value below so a fresh clone runs cold. Regenerate for anything real:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=zoqOPuWJazMzBGrnw2AdBlqfHStgQWwzgeGoJf-7UYo=

# Infra (compose service names; override for local non-docker runs)
DATABASE_URL=postgresql+psycopg://qrex:qrex@db:5432/qrex
REDIS_URL=redis://redis:6379/0
MOCK_PLATFORM_URL=http://mock-platform:9000

# Public URLs — what a *browser* uses to reach each service. Used in alert
# emails / re-auth links, and baked into the dashboard at build time.
# On a server, replace localhost with the server's hostname or IP, then
# `docker compose up -d --build web`.
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
PUBLIC_MOCK_URL=http://localhost:9000

# Default sync interval (seconds) if a connector's config_json sets none
SYNC_DEFAULT_INTERVAL=60

# Mock platform session lifetime (seconds). Health probe warns before this.
MOCK_SESSION_TTL_SECONDS=43200

# ---- External alert channels (at least one should be configured) ----------
# Email: compose ships Mailpit (SMTP capture, UI at http://localhost:8025)
ALERT_EMAIL_ENABLED=true
ALERT_EMAIL_HOST=mailpit
ALERT_EMAIL_PORT=1025
ALERT_EMAIL_USER=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_FROM=qrex-alerts@localhost
ALERT_EMAIL_TO=seller@brand.local
ALERT_EMAIL_STARTTLS=false

# Telegram (optional): leave blank to disable
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Directories for email-ingest drop folder and manual uploads
INBOX_DIR=/code/data/inbox
UPLOAD_DIR=/code/data/uploads
